---
const currentPath = Astro.url.pathname;
---

<aside class="sidebar" aria-label="Main Navigation">
  <div class="sidebar-header">
    <a href="/" class="sidebar-brand">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f4c81" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
        <path d="M2 17l10 5 10-5"></path>
        <path d="M2 12l10 5 10-5"></path>
      </svg>
      <span>BitTrade Q-Lab</span>
    </a>
  </div>
  
  <div class="sidebar-content">
    <div class="sidebar-group-title">Overview & Portal</div>
    <ul class="sidebar-nav">
      <li>
        <a href="/" class={currentPath === "/" ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          <span>Main Dashboard (All Bots)</span>
        </a>
      </li>
    </ul>

    <div class="sidebar-group-title">Algorithmic Engines</div>
    <ul class="sidebar-nav">
      <li>
        <a href="/bota/" class={currentPath.startsWith("/bota") || currentPath.includes("dashboard") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          <span>Bot A: Trend System</span>
        </a>
      </li>
      <li>
        <a href="/dca/" class={currentPath.startsWith("/dca") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          <span>Bot B: SmartDCA</span>
        </a>
      </li>
      <li>
        <a href="/grid/" class={currentPath.startsWith("/grid") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line></svg>
          <span>Bot C: Grid Engine</span>
        </a>
      </li>
      <li>
        <a href="/arbitrage/" class={currentPath.startsWith("/arbitrage") && !currentPath.includes("paper") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
          <span>Bot D: Arbitrage Engine</span>
        </a>
      </li>
      <li>
        <a href="/statarb/" class={currentPath.startsWith("/statarb") && !currentPath.includes("paper") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2z"></path><path d="M12 16v-4"></path><path d="M8 16v-2"></path><path d="M16 16v-6"></path></svg>
          <span>Bot E: statARB</span>
        </a>
      </li>
    </ul>

    <div class="sidebar-group-title">Scientific Documentation</div>
    <ul class="sidebar-nav">
      <li>
        <a href="/paper_statarb" class={currentPath.includes("paper_") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          <span>Research Papers</span>
        </a>
        <ul class="sidebar-subnav">
          <li><a href="/paper_a">• Paper Bot A (Trend)</a></li>
          <li><a href="/paper_b">• Paper Bot B (DCA)</a></li>
          <li><a href="/paper_grid">• Paper Bot C (Grid)</a></li>
          <li><a href="/paper_arbitrage">• Paper Bot D (Arbitrage)</a></li>
          <li><a href="/paper_statarb">• Paper Bot E (statARB)</a></li>
        </ul>
      </li>
    </ul>

    <div class="sidebar-group-title">Simulation & Lab</div>
    <ul class="sidebar-nav">
      <li>
        <a href="/backtest" class={currentPath.includes("backtest") ? "sidebar-link active" : "sidebar-link"}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Backtest Simulator</span>
        </a>
      </li>
    </ul>
  </div>
</aside>
