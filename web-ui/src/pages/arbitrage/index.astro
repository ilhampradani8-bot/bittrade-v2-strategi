---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Funding Rate Arbitrage Dashboard | BitTrade Q-Lab">
  <div class="dashboard-container">
        <h1>Funding Rate Arbitrage Dashboard (Cash-and-Carry)</h1>

    <!-- Account Profile Switcher -->
    <div style="margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1.5px solid var(--border-color); display: flex; gap: 10px; align-items: center; justify-content: flex-end; flex-wrap: wrap;">
        <span style="font-size: 0.9em; color: var(--text-muted); font-weight: bold; font-family: 'Inter', sans-serif; display: flex; align-items: center; gap: 6px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>
            Active Portfolio Profile:
        </span>
        <button class="filter-btn active" id="profile-retail-btn" style="border-radius: 4px;">Retail ($200 | 3 Coins)</button>
        <button class="filter-btn" id="profile-inst-btn" style="border-radius: 4px;">Institutional ($2,000 | 8 Coins)</button>
    </div>

    <!-- Main Tab Navigation -->
    <div class="section-container" style="border-bottom: none; margin-bottom: 20px; padding-bottom: 0px;">
        <div style="display: flex; align-items: center; gap: 5px; width: 100%;">
            <!-- Left scroll button -->
            <button id="scroll-tab-left" class="filter-btn" style="padding: 8px 12px; border-radius: 4px; display: none; align-items: center; justify-content: center; font-size: 1em; border: 1.5px solid var(--border-color); flex-shrink: 0; background: var(--paper-bg); cursor: pointer;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            
            <!-- Tab list -->
            <div id="tab-nav-container" class="tab-navigation" style="display: flex; gap: 10px; border-bottom: 2px solid var(--border-color); padding-bottom: 0px; margin-bottom: 0px; overflow-x: auto; scroll-behavior: smooth; flex-grow: 1; -webkit-overflow-scrolling: touch; scrollbar-width: none;">
                <button class="tab-btn active" data-tab="tab-overview" style="display: flex; align-items: center; gap: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    Overview & Performance
                </button>
                <button class="tab-btn" data-tab="tab-active-state" style="display: flex; align-items: center; gap: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    Active Positions Details
                </button>
                <button class="tab-btn" data-tab="tab-trade-history" style="display: flex; align-items: center; gap: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                    Trade History (Buy/Sell)
                </button>
                <button class="tab-btn" data-tab="tab-funding-logs" style="display: flex; align-items: center; gap: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    Funding Payout Logs
                </button>
                <button class="tab-btn" data-tab="tab-market-scanner" style="display: flex; align-items: center; gap: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    Market Scanner (Top FR)
                </button>
                <button class="tab-btn" data-tab="tab-faq" style="display: flex; align-items: center; gap: 6px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                    FAQ & Guides
                </button>
            </div>
            
            <!-- Right scroll button -->
            <button id="scroll-tab-right" class="filter-btn" style="padding: 8px 12px; border-radius: 4px; display: none; align-items: center; justify-content: center; font-size: 1; border: 1.5px solid var(--border-color); flex-shrink: 0; background: var(--paper-bg); cursor: pointer;">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
        </div>
    </div>

    <!-- Tab Contents Container -->
    <div class="tab-contents-container">
        <!-- Tab 1: Overview & Performance -->
        <div id="tab-overview" class="tab-pane active">
            <!-- Info Cards Row (2 Columns Line Separated) -->
            <div class="grid-2 section-container">
        <!-- Col 1: Real-time Market -->
        <div style="padding-right: 20px;">
            <h2 style="border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px;">Arbitrage Market Overview</h2>
            <div style="margin-bottom: 15px;">
                <div class="label">Index BTC/USDT Price</div>
                <div class="price-val" id="btc-price">$-</div>
            </div>
            <div class="stat-row">
                <span class="label">System CPU Usage</span>
                <span class="value" id="cpu-counter">-%</span>
            </div>
            <div class="stat-row">
                <span class="label">System Memory</span>
                <span class="value" id="ram-counter">- MB</span>
            </div>
        </div>
        
        <!-- Col 2: Account & Balance -->
        <div style="border-left: 1px dashed var(--border-color); padding-left: 20px;">
            <h2 style="border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px;">USDT Account & Balance</h2>
            <div class="stat-row">
                <span class="label">Starting Capital</span>
                <span class="value" id="starting-capital-val" style="font-family: monospace;">$200.00</span>
            </div>
            <div class="stat-row">
                <span class="label">Futures Leverage</span>
                <span class="value" style="color: var(--accent-blue); font-weight: bold;">10x Leverage</span>
            </div>
            <div class="stat-row">
                <span class="label">Max Arb Hedged Cap</span>
                <span class="value" id="leverage-power-val" style="color: var(--text-secondary); font-family: monospace; font-weight: bold;">$181.81</span>
            </div>
            <div class="stat-row" style="border-top: 1px dashed var(--border-color); padding-top: 4px; margin-top: 4px;">
                <span class="label" style="color: var(--text-muted); font-size: 0.9em; padding-left: 10px;">↳ Active Spot Capital (1x)</span>
                <span class="value" id="active-spot-locked" style="font-family: monospace; color: var(--text-secondary);">$0.00</span>
            </div>
            <div class="stat-row">
                <span class="label" style="color: var(--text-muted); font-size: 0.9em; padding-left: 10px;">↳ Active Futures Capital (10x)</span>
                <span class="value" id="active-futures-margin" style="font-family: monospace; color: var(--text-secondary);">$0.00</span>
            </div>
            <div class="stat-row" style="border-top: 1px dashed var(--border-color); padding-top: 4px;">
                <span class="label">Available Cash (Free)</span>
                <span class="value" id="usdt-balance" style="font-family: monospace;">$200.00</span>
            </div>
            <div class="stat-row" style="border-top: 1px solid var(--border-color); padding-top: 8px; margin-top: 8px;">
                <span class="label">Total Portfolio Value (Real Net Equity)</span>
                <span class="value" id="total-equity-val" style="font-family: monospace; font-weight: bold; color: var(--accent-blue);">$200.00</span>
            </div>
            <div class="stat-row">
                <span class="label">Total Funding Collected</span>
                <span class="value" id="pnl-value" style="font-family: monospace;">$0.00 (0.00%)</span>
            </div>
        </div>
    </div>

    <!-- Investment Projection & Compounding Simulator Card -->
    <div class="grid-2 section-container" style="background: rgba(15, 76, 129, 0.03); border: 1.5px solid var(--border-color); padding: 20px; border-radius: 6px; margin-bottom: 30px;">
        <!-- Column 1: Projections for $200 Capital -->
        <div>
            <h3 style="border-bottom: 2px solid var(--accent-blue); padding-bottom: 8px; margin-bottom: 15px; color: var(--accent-blue); font-size: 1.15em; display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                $200 Capital Profit Projection
            </h3>
            <div style="font-size: 0.85em; color: var(--text-secondary); margin-bottom: 12px; font-style: italic;">
                Estimated passive returns for **$200 starting capital** (3 Coins):
            </div>
            <table style="width: 100%; font-size: 0.85em; text-align: left; background: #ffffff;">
                <thead>
                    <tr style="background: #f3efe6;">
                        <th style="padding: 6px;">Market Scenario</th>
                        <th style="padding: 6px;">Est. APR</th>
                        <th style="padding: 6px;">Daily Yield</th>
                        <th style="padding: 6px;">Monthly Yield</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 6px; font-weight: bold; color: var(--text-primary);">Bearish Market</td>
                        <td style="padding: 6px;">25% APR</td>
                        <td style="padding: 6px; color: var(--accent-green); font-weight: bold;">+$0.12</td>
                        <td style="padding: 6px; color: var(--accent-green); font-weight: bold;">+$3.70</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px; font-weight: bold; color: var(--accent-blue);">Normal Market</td>
                        <td style="padding: 6px;">50% APR</td>
                        <td style="padding: 6px; color: var(--accent-green); font-weight: bold;">+$0.25</td>
                        <td style="padding: 6px; color: var(--accent-green); font-weight: bold;">+$7.40</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px; font-weight: bold; color: var(--text-primary);">Bullish Market</td>
                        <td style="padding: 6px;">80% APR</td>
                        <td style="padding: 6px; color: var(--accent-green); font-weight: bold;">+$0.40</td>
                        <td style="padding: 6px; color: var(--accent-green); font-weight: bold;">+$11.80</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Column 2: Compounding Calculator -->
        <div style="border-left: 1.5px dashed var(--border-color); padding-left: 20px;">
            <h3 style="border-bottom: 2px solid var(--accent-blue); padding-bottom: 8px; margin-bottom: 15px; color: var(--accent-blue); font-size: 1.15em; display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                Compounding Growth Calculator
            </h3>
            <div style="font-size: 0.85em; color: var(--text-secondary); margin-bottom: 15px;">
                Calculate compound interest growth from <strong>$200 starting capital</strong> (at average 50% APR / 4.5% monthly ROI for Top 3 Coins):
            </div>
            <div class="stat-row">
                <span class="label">Time to double capital ($400)</span>
                <span class="value" style="color: var(--accent-green); font-family: monospace;">16 Months</span>
            </div>
            <div class="stat-row">
                <span class="label">Time to accumulate $100 profit</span>
                <span class="value" style="color: var(--accent-green); font-family: monospace;">13.5 Months</span>
            </div>
            <div class="stat-row" style="border-top: 1px solid var(--border-color); padding-top: 8px; margin-top: 8px;">
                <span class="label">Capital in 24 Months (Compounded)</span>
                <span class="value" style="color: var(--accent-blue); font-family: monospace;">$575.20</span>
            </div>
        </div>
    </div>

    <!-- Process Status Lights (Multi-Coin) -->
    <div class="section-container">
        <h2 style="font-size: 1.1em; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px;">System Process Pipeline Monitor (Real-time)</h2>
        <div class="scroller" style="max-height: none; border: none;">
            <table style="width: 100%; border-collapse: collapse; text-align: center; font-size: 0.9em;">
                <thead>
                    <tr style="background: rgba(0,0,0,0.02); color: var(--text-secondary);">
                        <th style="padding: 10px; border-bottom: 1px solid var(--border-color); text-align: left;">Engine Pipeline</th>
                        <th style="padding: 10px; border-bottom: 1px solid var(--border-color);">Binance WSS Stream</th>
                        <th style="padding: 10px; border-bottom: 1px solid var(--border-color);">Data Initializer</th>
                        <th style="padding: 10px; border-bottom: 1px solid var(--border-color);">Market Scanner</th>
                        <th style="padding: 10px; border-bottom: 1px solid var(--border-color);">Arb Validator</th>
                        <th style="padding: 10px; border-bottom: 1px solid var(--border-color);">Two-Leg Executor</th>
                    </tr>
                </thead>
                <tbody id="pipeline-body">
                    <tr><td colspan="6" style="text-align: center; color: var(--text-secondary);">Loading pipeline status...</td></tr>
                </tbody>
            </table>
        </div>
        
        <div style="margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 10px; text-align: left;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 0.9em; color: var(--text-secondary);">Error Corrector (Global):</span>
                <div class="led-light" id="led-corrector"></div>
            </div>
        </div>
    </div>

    <div class="section-container">
        <h2 style="border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px;">Active Arbitrage Positions APR & Basis Overview</h2>
        <div id="mtfa-container" style="display: flex; flex-direction: row; gap: 15px; overflow-x: auto; padding: 5px 0 15px; scrollbar-width: thin; -webkit-overflow-scrolling: touch;">
            <div style="text-align: center; color: var(--text-secondary); width: 100%; grid-column: 1 / -1;">Loading market data...</div>
        </div>
    </div>
    <!-- Charts Row -->
    <div class="charts-container">
        <div class="chart-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h2 style="font-size: 1.2em; margin: 0;">Real-time Price</h2>
                <select id="chart-coin-selector" style="background: var(--card-bg); color: var(--text-primary); border: 1px solid var(--border-color); padding: 4px 8px; border-radius: 4px;">
                    <option value="BTC">BTC</option>
                    <option value="ETH">ETH</option>
                    <option value="BNB">BNB</option>
                    <option value="SOL">SOL</option>
                    <option value="XRP">XRP</option>
                </select>
            </div>
            <div style="height: 190px;"><canvas id="priceChart"></canvas></div>
        </div>
        <div class="chart-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h2 style="font-size: 1.2em; margin: 0;">Asset Equity Growth (USDT)</h2>
                <div style="display: flex; gap: 5px;">
                    <button class="filter-btn active">Seconds</button>
                    <button class="filter-btn">Hours</button>
                    <button class="filter-btn">Days</button>
                    <button class="filter-btn">Months</button>
                </div>
            </div>
            <div style="height: 190px;"><canvas id="balanceChart"></canvas></div>
        </div>
    </div>
        </div>
        <!-- Tab 1: Active Arbitrage Details -->
        <div id="tab-active-state" class="tab-pane">
            <div class="section-container">
                <h2 style="display: flex; align-items: center; gap: 8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    Detailed Active Arbitrage State
                </h2>
                <div style="margin-bottom: 15px; font-size: 0.9em; color: var(--text-secondary);">
                    Detailed real-time indicators, entry prices, basis spreads, and collected funding rates per position.
                </div>
                <div class="scroller" style="max-height: 350px;">
                    <table>
                        <thead>
                            <tr>
                                <th>Coin (Symbol)</th>
                                <th>Spot Entry</th>
                                <th>Futures Entry</th>
                                <th>Current Spot</th>
                                <th>Current Futures</th>
                                <th>Basis Spread %</th>
                                <th>Real Modal Deployed</th>
                                <th>Total Funding</th>
                                <th>Collect Count</th>
                                <th>Annualized APR %</th>
                            </tr>
                        </thead>
                        <tbody id="altcoin-details-body">
                            <tr><td colspan="10" style="text-align: center; color: var(--text-secondary);">Loading detailed info...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 2: Trade History (Buy/Sell) -->
        <div id="tab-trade-history" class="tab-pane">
            <div class="section-container">
                <h2 id="history-title">Arbitrage Trade History (alt_trading_history)</h2>
                <div style="margin-bottom: 15px; font-size: 0.9em; color: var(--text-secondary);">
                    Complete trade execution history, displaying both physical Spot buy/sell and hedging Futures short/cover legs.
                </div>
                <div class="scroller" style="max-height: 350px;">
                    <table>
                        <thead>
                            <tr>
                                <th>Time (Timestamp)</th>
                                <th>Action</th>
                                <th>Coin (Symbol)</th>
                                <th>Price</th>
                                <th>Amount & USD Value</th>
                                <th>Notes / Fees / P&L</th>
                            </tr>
                        </thead>
                        <tbody id="history-body"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Tab 3: Funding Payment Payout Logs -->
        <div id="tab-funding-logs" class="tab-pane">
            <div class="section-container">
                <h2 style="display: flex; align-items: center; gap: 8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    Funding Payment Collect Logs
                </h2>
                <div style="margin-bottom: 15px; font-size: 0.9em; color: var(--text-secondary);">
                    Log entries of passive cash-and-carry funding rate payouts received every 8 hours.
                </div>

                <!-- Summary Cards & Settlement Schedule Table -->
                <div class="grid-2" style="margin-bottom: 25px; gap: 15px;">
                    <div style="background: rgba(15, 76, 129, 0.02); border: 1px solid var(--border-color); padding: 15px; border-radius: 4px;">
                        <h4 style="margin: 0 0 10px; color: var(--accent-blue); font-family: Georgia, serif;">📊 Yield Summary</h4>
                        <div class="stat-row"><span class="label">Total Funding Collected:</span><span class="value" id="funding-summary-total">$0.00</span></div>
                        <div class="stat-row"><span class="label">Daily Average:</span><span class="value" id="funding-summary-daily" style="color: var(--accent-green); font-family: monospace;">$0.00 / day</span></div>
                        <div class="stat-row"><span class="label">Date Range:</span><span class="value" id="funding-summary-range" style="font-size:0.8em; font-family: monospace;">- to -</span></div>
                    </div>
                    <div style="background: #ffffff; border: 1px solid var(--border-color); padding: 15px; border-radius: 4px;">
                        <h4 style="margin: 0 0 10px; color: var(--accent-blue); font-family: Georgia, serif;">⏰ Binance Funding Payout Schedule</h4>
                        <table style="width: 100%; font-size: 0.8em; border: none; text-align: left; background: #ffffff;">
                            <thead>
                                <tr style="background: #f3efe6;">
                                    <th style="padding: 4px; border: none;">Session</th>
                                    <th style="padding: 4px; border: none;">UTC Time</th>
                                    <th style="padding: 4px; border: none;">WIB Time</th>
                                    <th style="padding: 4px; border: none;">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td style="padding: 4px; border: none;">Morning Session</td>
                                    <td style="padding: 4px; border: none; font-family: monospace;">00:00 UTC</td>
                                    <td style="padding: 4px; border: none; font-family: monospace;">07:00 WIB</td>
                                    <td style="padding: 4px; border: none;" id="session-status-morning">Pending</td>
                                </tr>
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td style="padding: 4px; border: none;">Afternoon Session</td>
                                    <td style="padding: 4px; border: none; font-family: monospace;">08:00 UTC</td>
                                    <td style="padding: 4px; border: none; font-family: monospace;">15:00 WIB</td>
                                    <td style="padding: 4px; border: none;" id="session-status-afternoon">Pending</td>
                                </tr>
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td style="padding: 4px; border: none;">Night Session</td>
                                    <td style="padding: 4px; border: none; font-family: monospace;">16:00 UTC</td>
                                    <td style="padding: 4px; border: none; font-family: monospace;">23:00 WIB</td>
                                    <td style="padding: 4px; border: none;" id="session-status-night">Pending</td>
                                </tr>
                            </tbody>
                        </table>
                        <div style="font-size: 0.7em; color: var(--text-muted); margin-top: 6px; font-style: italic;">
