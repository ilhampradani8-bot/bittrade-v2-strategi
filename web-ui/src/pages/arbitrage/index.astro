    <script is:inline>
        // Inline client-side tab switcher logic
        document.addEventListener('DOMContentLoaded', () => {
            const tabBtns = document.querySelectorAll('.tab-btn');
            const tabPanes = document.querySelectorAll('.tab-pane');
            
            tabBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const targetTab = this.getAttribute('data-tab');
                    
                    // Switch button active status
                    tabBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    
                    // Switch content panel visibility
                    tabPanes.forEach(pane => {
                        if (pane.id === targetTab) {
                            pane.classList.add('active');
                        } else {
                            pane.classList.remove('active');
                        }
                    });
                });
            });

            // Scroll button handlers for tab navigation
            const tabNav = document.getElementById('tab-nav-container');
            const btnLeft = document.getElementById('scroll-tab-left');
            const btnRight = document.getElementById('scroll-tab-right');

            if (tabNav && btnLeft && btnRight) {
                const updateScrollButtons = () => {
                    const hasOverflow = tabNav.scrollWidth > tabNav.clientWidth;
                    if (hasOverflow) {
                        btnLeft.style.display = tabNav.scrollLeft > 5 ? 'flex' : 'none';
                        const maxScroll = tabNav.scrollWidth - tabNav.clientWidth;
                        btnRight.style.display = tabNav.scrollLeft < maxScroll - 5 ? 'flex' : 'none';
                    } else {
                        btnLeft.style.display = 'none';
                        btnRight.style.display = 'none';
                    }
                };

                tabNav.addEventListener('scroll', updateScrollButtons);
                window.addEventListener('resize', updateScrollButtons);

                btnLeft.addEventListener('click', () => {
                    tabNav.scrollBy({ left: -150, behavior: 'smooth' });
                });

                btnRight.addEventListener('click', () => {
                    tabNav.scrollBy({ left: 150, behavior: 'smooth' });
                });

                // Init after some delay to let layout render
                setTimeout(updateScrollButtons, 300);
            }

            // Accordion hide/show logic for FAQ
            const faqQuestions = document.querySelectorAll('.faq-question');
            faqQuestions.forEach(btn => {
                btn.addEventListener('click', function() {
                    const answer = this.nextElementSibling;
                    const icon = this.querySelector('.faq-icon');
                    
                    if (answer.style.maxHeight && answer.style.maxHeight !== '0px') {
                        answer.style.maxHeight = '0px';
                        icon.style.transform = 'rotate(0deg)';
                    } else {
                        // Close all other FAQ answers first for cleaner UX
                        document.querySelectorAll('.faq-answer').forEach(ans => {
                            ans.style.maxHeight = '0px';
                        });
                        document.querySelectorAll('.faq-icon').forEach(ic => {
                            ic.style.transform = 'rotate(0deg)';
                        });
                        
                        answer.style.maxHeight = answer.scrollHeight + 'px';
                        icon.style.transform = 'rotate(180deg)';
                    }
                });
            });

            // Sub-tab switching logic for FAQ groups
            const faqSubTabBtns = document.querySelectorAll('.faq-sub-tab-btn');
            const faqGroupPanes = document.querySelectorAll('.faq-group-pane');
            
            faqSubTabBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const targetGroup = this.getAttribute('data-faq-group');
                    
                    faqSubTabBtns.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    
                    faqGroupPanes.forEach(pane => {
                        if (pane.id === targetGroup) {
                            pane.style.display = 'block';
                        } else {
                            pane.style.display = 'none';
                        }
                    });
                });
            });
        });
    </script>

