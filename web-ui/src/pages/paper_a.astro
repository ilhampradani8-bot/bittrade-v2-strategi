<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const links = document.querySelectorAll('.toc-link');
        const sections = document.querySelectorAll('.article-section-content, .paper-abstract-box');
        
        // Mobile TOC Toggle
        const mobileTocToggle = document.getElementById('mobileTocToggle');
        const tocSidebar = document.getElementById('tocSidebar');
        const closeToc = document.getElementById('closeToc');
        
        if (mobileTocToggle && tocSidebar && closeToc) {
            mobileTocToggle.addEventListener('click', () => {
                tocSidebar.classList.add('open');
            });
            closeToc.addEventListener('click', () => {
                tocSidebar.classList.remove('open');
            });
            
            // Close sidebar when clicking a link on mobile
            links.forEach(link => {
                link.addEventListener('click', () => {
                    if (window.innerWidth <= 768) {
                        tocSidebar.classList.remove('open');
                    }
                });
            });
        }

        // Scroll spy to highlight active TOC item
        function scrollSpy() {
            let currentActiveId = '';
            const scrollPos = window.scrollY + 120; // offset

            sections.forEach(section => {
                if (section.offsetTop <= scrollPos) {
                    currentActiveId = section.getAttribute('id');
                }
            });

            if (currentActiveId) {
                links.forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href') === `#${currentActiveId}`) {
                        link.classList.add('active');
                    }
                });
            }
        }

        // Click handler for smooth scrolling
        links.forEach(link => {
            link.addEventListener('click', (e) => {
                e.preventDefault();
                const targetId = link.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    const topOffset = targetElement.offsetTop - 100;
                    window.scrollTo({
                        top: topOffset,
                        behavior: 'smooth'
                    });
                }
            });
        });

        window.addEventListener('scroll', scrollSpy);
        scrollSpy(); // Initial call
    });
</script>

