                <span style="font-size:0.85em;">© 2026 Tim Peneliti BitTrade-v2 Grid Engine. Dipublikasikan di bawah lisensi CC BY 4.0.</span><br/>
                <span style="font-size:0.85em;">DOI: {PAPER_DOI} · URL: {PAPER_URL}</span>
              </div>
            </div>

          </div><!-- #pages-container -->
        </div><!-- #pages-viewport -->

        <!-- BOOK NAVIGATION BAR -->
        <div class="book-nav-bar">
          <div class="page-indicator"><span id="currentPage">1</span> / 10</div>
        </div>

        <button id="btnPrev" class="btn-action floating-btn left-btn" disabled>&#10094;</button>
        <button id="btnNext" class="btn-action floating-btn right-btn">&#10095;</button>

      </div><!-- .latex-document -->
    </div><!-- .paper-main-content -->
  </div><!-- .paper-layout-wrapper -->

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let currentPage = 0;
      const totalPages = 10;
      const pagesContainer = document.getElementById('pages-container');
      const links = document.querySelectorAll('.toc-link');
      const btnPrev = document.getElementById('btnPrev');
      const btnNext = document.getElementById('btnNext');
      const pageIndicator = document.getElementById('currentPage');

      function showPage(index) {
        links.forEach(l => l.classList.remove('active'));
        const targetLink = document.querySelector(`.toc-link[data-target="${index}"]`);
        if (targetLink) targetLink.classList.add('active');

        pagesContainer.style.transform = `translateX(-${index * 10}%)`;

        const pages = document.querySelectorAll('.book-page');
        const viewport = document.getElementById('pages-viewport');
        if (pages[index]) {
          viewport.style.height = pages[index].offsetHeight + 'px';
          viewport.style.transition = 'height 0.4s ease';
        }

        currentPage = index;
        pageIndicator.innerText = (index + 1);
        btnPrev.disabled = index === 0;
        btnNext.disabled = index === totalPages - 1;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      links.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const target = parseInt(link.getAttribute('data-target'));
          showPage(target);
        });
      });

      btnPrev.addEventListener('click', () => { if (currentPage > 0) showPage(currentPage - 1); });
      btnNext.addEventListener('click', () => { if (currentPage < totalPages - 1) showPage(currentPage + 1); });

      // Mobile TOC
      const mobileTocToggle = document.getElementById('mobileTocToggle');
      const tocSidebar = document.getElementById('tocSidebar');
      const closeToc = document.getElementById('closeToc');
      if (mobileTocToggle && tocSidebar && closeToc) {
        mobileTocToggle.addEventListener('click', () => tocSidebar.classList.add('open'));
        closeToc.addEventListener('click', () => tocSidebar.classList.remove('open'));
        links.forEach(link => {
          link.addEventListener('click', () => {
            if (window.innerWidth <= 768) tocSidebar.classList.remove('open');
          });
        });
      }

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' && currentPage < totalPages - 1) showPage(currentPage + 1);
        if (e.key === 'ArrowLeft' && currentPage > 0) showPage(currentPage - 1);
      });

      setTimeout(() => showPage(0), 50);
    });
  </script>
</Layout>

