---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="SmartDCA Bot Engine Real-time | BitTrade Q-Lab"
  botStatus="BOT B ONLINE"
>
  <div class="dashboard-container">
    <!-- System Status Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--border-color); padding-bottom: 15px; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;">
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <h1 style="margin: 0; font-size: 1.8em; font-weight: bold; border-bottom: none; padding-bottom: 0;">SmartDCA Engine Real-time <span class="en-sub">SmartDCA Real-time Trading Engine</span></h1>
        </div>
        <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
            <div class="uptime-badge">Masa Aktif Bot: <span id="uptime-counter">00:00:00</span> <span class="en-sub" style="color: inherit; display: inline; font-size: 0.9em; margin-left: 3px;">(Bot Uptime)</span></div>
            <div class="uptime-badge" style="border-color: var(--accent-green); color: var(--accent-green); font-weight: bold;">Winrate Bot: <span id="winrate-counter">0.0%</span> <span class="en-sub" style="color: inherit; display: inline; font-size: 0.9em; margin-left: 3px;">(Bot Winrate)</span></div>
            <div class="uptime-badge" style="border-color: var(--accent-blue); color: var(--accent-blue);">CPU: <span id="cpu-counter">0.0%</span></div>
            <div class="uptime-badge" style="border-color: var(--accent-blue); color: var(--accent-blue);">RAM: <span id="ram-counter">0 MB</span></div>
        </div>
    </div>

    <!-- Page Navigation Tabs -->
    <div style="display: flex; gap: 8px; border-bottom: 2px solid var(--border-color); padding-bottom: 12px; margin-bottom: 25px; flex-wrap: wrap;">
      <button id="btn-page-overview" class="page-tab-btn active" onclick="switchPageTab('overview')">
        Overview <span style="font-size: 0.8em; font-style: italic; display: block; font-weight: normal; opacity: 0.8;">Ringkasan</span>
      </button>
      <button id="btn-page-scanner" class="page-tab-btn" onclick="switchPageTab('scanner')">
        Volatility Scanner <span style="font-size: 0.8em; font-style: italic; display: block; font-weight: normal; opacity: 0.8;">Pemindai Koin Volatil</span>
      </button>
      <button id="btn-page-cycles" class="page-tab-btn" onclick="switchPageTab('cycles')">
        DCA Cycle History <span style="font-size: 0.8em; font-style: italic; display: block; font-weight: normal; opacity: 0.8;">Riwayat Siklus DCA</span>
      </button>
      <button id="btn-page-history" class="page-tab-btn" onclick="switchPageTab('history')">
        Trade History <span style="font-size: 0.8em; font-style: italic; display: block; font-weight: normal; opacity: 0.8;">Riwayat Transaksi</span>
      </button>
    </div>

    <!-- Tab 1: Overview Section -->
    <div id="section-overview" class="page-section">
      <!-- Pipeline Status Indicators -->
      <div class="indicator-row">
          <div class="indicator-badge">
              <span class="led-light" id="led-ws"></span> WebSocket Feed
          </div>
          <div class="indicator-badge">
              <span class="led-light" id="led-conclude"></span> Conclude Engine (DCA)
          </div>
          <div class="indicator-badge">
              <span class="led-light" id="led-validate"></span> Risk Validator
          </div>
          <div class="indicator-badge">
              <span class="led-light" id="led-executor"></span> Order Executor
          </div>
      </div>

      <!-- Metrics Grid -->
      <div class="metrics-grid">
          <div class="metric-card">
              <h3>Total Saldo Asli <span class="en-sub">Original Net Worth</span></h3>
              <div class="metric-value" id="equity-val">$0.00</div>
              <div class="metric-subtext">Cash + Floating Value</div>
          </div>
          <div class="metric-card">
              <h3>Daya Beli Leverage (3x) <span class="en-sub">Leveraged Buying Power</span></h3>
              <div class="metric-value" id="leveraged-equity-val">$0.00</div>
              <div class="metric-subtext">Original Net Worth x 3</div>
          </div>
          <div class="metric-card">
              <h3>Modal Terpakai (Margin) <span class="en-sub">Margin Spent</span></h3>
              <div class="metric-value" id="margin-spent-val">$0.00</div>
              <div class="metric-subtext">In Active Positions</div>
          </div>
          <div class="metric-card">
              <h3>Modal Bebas / Tak Terpakai <span class="en-sub">Available USDT</span></h3>
              <div class="metric-value" id="balance-val">$0.00</div>
              <div class="metric-subtext">Free USDT remaining</div>
          </div>
      </div>

      <!-- Main Panel Grid -->
      <div class="main-panel-grid">
          <!-- Left Panel: Equity Chart -->
          <div class="panel-box">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                <h2 class="panel-title" style="margin: 0; border: none; padding-bottom: 0;">📉 Equity Curve <span class="en-sub">(DCA Simulation)</span></h2>
                <button id="btn-chart-all" class="chart-toggle-btn" onclick="toggleBalanceHistoryRange()">
                  Tampilkan Semua Data <span style="font-size: 0.85em; font-weight: normal; opacity: 0.8; margin-left: 3px;">(Show All Data)</span>
                </button>
              </div>
              <div class="chart-container">
                  <canvas id="equityChart"></canvas>
              </div>
          </div>

          <!-- Right Panel: Active Position Summary Table -->
          <div class="panel-box" style="display: flex; flex-direction: column; justify-content: space-between;">
              <div>
                  <h2 class="panel-title">💼 Posisi Aktif Saat Ini <span class="en-sub">Current Active Positions</span></h2>
                  <div style="overflow-x: auto;">
                      <table>
                          <thead>
                              <tr>
                                  <th>Symbol</th>
                                  <th>Cycle</th>
                                  <th>Layers</th>
                                  <th>Avg Entry</th>
                                  <th>Current</th>
                                  <th>PnL</th>
                                  <th>Chart</th>
                              </tr>
                          </thead>
                          <tbody id="active-positions-table-body">
                              <tr>
                                  <td colspan="7" style="text-align: center; color: var(--text-secondary);">Tidak ada posisi aktif</td>
                              </tr>
                          </tbody>
                      </table>
                  </div>
              </div>
              <div style="margin-top: 15px; display: flex; flex-direction: column; gap: 8px;">
                  <div style="font-size: 0.85em; color: var(--text-secondary); text-align: center;">Leverage: <span style="font-weight: bold; color: var(--accent-green);">Futures (3x Leverage)</span></div>
                  <button class="btn btn-danger" onclick="triggerManualSell()" style="width: 100%; padding: 10px;">🚨 EMERGENCY MANUAL SELL <span style="font-size: 0.8em; font-style: italic; display: block; font-weight: normal; opacity: 0.85;">Jual Manual Darurat</span></button>
              </div>
              
              <!-- Strategy Rules Documentation Box -->
              <div style="margin-top: 20px; border-top: 1.5px dashed var(--border-color); padding-top: 15px; font-size: 0.8em; color: var(--text-secondary);">
                  <h4 style="margin: 0 0 8px 0; font-weight: bold; color: var(--text-primary); font-size: 1.05em;">Parameter SmartDCA Teroptimasi:</h4>
                  <ul style="margin: 0; padding-left: 15px; display: flex; flex-direction: column; gap: 6px; line-height: 1.4;">
                      <li><strong>Layer 1 (40%):</strong> Drop &le; -2.5%, RSI &lt; 50, lolos RSI Allowed &amp; EMA-750.</li>
                      <li><strong>Layer 2 (30%):</strong> Drop &le; -5.0%, RSI &lt; 50 (Bebas filter RSI Allowed).</li>
                      <li><strong>Layer 3 (30%):</strong> Drop &le; -8.0%, RSI &lt; 40 (Bebas filter RSI Allowed).</li>
                      <li><strong>Exit Logic:</strong> TP Hard +2.5% | Trailing TP (pullback 0.8% dari +1.5% HWM) | Stop Loss -5.0%.</li>
                  </ul>
              </div>
          </div>
      </div>

      <!-- Log Console -->
      <div class="panel-box" style="margin-top: 25px; border: none; border-top: 1.5px solid var(--border-color);">
          <h2 class="panel-title" style="margin-bottom: 10px; border: none;">📋 Catatan Aktivitas Real-time <span class="en-sub">Real-time Activity Logs</span></h2>
          <div class="log-console" id="log-box">Loading logs...</div>
      </div>
    </div>

    <!-- Tab 2: Volatility Scanner Section -->
    <div id="section-scanner" class="page-section" style="display: none;">
      <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 12px; margin-bottom: 20px;">
        <h1 style="margin: 0; border: none; font-size: 1.6em; padding-bottom: 0;">Pemindai Volatilitas <span class="en-sub">Volatility Scanner (Top 100 Binance)</span></h1>
      </div>
      <div class="scroller" style="max-height: 600px; overflow-y: auto; position: relative;">
          <table>
              <thead>
                  <tr>
                      <th>Rank <span class="en-sub">Peringkat</span></th>
                      <th>Simbol <span class="en-sub">Symbol</span></th>
                      <th>Volatilitas (24j) <span class="en-sub">24h Volatility</span></th>
                      <th>Volume (24j) <span class="en-sub">24h Volume</span></th>
                      <th>Status <span class="en-sub">State</span></th>
                      <th>Lapisan Aktif <span class="en-sub">Active Layers</span></th>
                      <th>Aksi <span class="en-sub">Action</span></th>
                  </tr>
              </thead>
              <tbody id="scanner-table-body">
                  <tr>
                      <td colspan="7" style="text-align: center; color: var(--text-secondary);">Loading scanner data...</td>
                  </tr>
              </tbody>
          </table>
      </div>
    </div>

    <!-- Tab 2: Cycle History Section -->
    <div id="section-cycles" class="page-section" style="display: none;">
      <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 12px; margin-bottom: 20px;">
        <h1 style="margin: 0; border: none; font-size: 1.6em; padding-bottom: 0;">Riwayat Siklus DCA <span class="en-sub">DCA Cycle History (dca_cycle_summary)</span></h1>
      </div>
      <div class="scroller" style="max-height: 600px; overflow-y: auto; position: relative;">
          <table>
              <thead>
                  <tr>
                      <th>Simbol <span class="en-sub">Symbol</span></th>
                      <th>Siklus <span class="en-sub">Cycle</span></th>
                      <th>Rerata Masuk <span class="en-sub">Entry Avg</span></th>
                      <th>Harga Keluar <span class="en-sub">Exit Price</span></th>
                      <th>P&amp;L Bersih <span class="en-sub">Net P&amp;L ($)</span></th>
                      <th>Persen P&amp;L <span class="en-sub">P&amp;L %</span></th>
                      <th>Status <span class="en-sub">Status</span></th>
                  </tr>
              </thead>
              <tbody id="cycles-table-body">
                  <tr>
                      <td colspan="7" style="text-align: center; color: var(--text-secondary);">Loading cycles...</td>
                  </tr>
              </tbody>
          </table>
      </div>
    </div>

    <!-- Tab 3: Trade History Section -->
    <div id="section-history" class="page-section" style="display: none;">
      <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 12px; margin-bottom: 20px;">
        <h1 style="margin: 0; border: none; font-size: 1.6em; padding-bottom: 0;">Riwayat Transaksi <span class="en-sub">Recent Trade History (dca_trading_history)</span></h1>
      </div>
      <div class="scroller" style="max-height: 600px; overflow-y: auto; position: relative;">
          <table>
              <thead>
                  <tr>
                      <th>Waktu <span class="en-sub">Time</span></th>
                      <th>Simbol <span class="en-sub">Symbol</span></th>
                      <th>Siklus <span class="en-sub">Cycle</span></th>
                      <th>Aksi <span class="en-sub">Action</span></th>
                      <th>Lapisan <span class="en-sub">Layer</span></th>
                      <th>Harga <span class="en-sub">Price</span></th>
                      <th>Jumlah <span class="en-sub">Amount</span></th>
                      <th>Modal <span class="en-sub">Capital</span></th>
                      <th>Biaya/PNL <span class="en-sub">Cost/PnL</span></th>
                  </tr>
              </thead>
              <tbody id="history-table-body">
                  <tr>
                      <td colspan="9" style="text-align: center; color: var(--text-secondary);">Loading trades...</td>
                  </tr>
              </tbody>
          </table>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline src="/dca/js/dashboard.js"></script>
</Layout>

<style is:global>
  .dashboard-container {
      background-color: transparent;
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      padding: 20px 15px;
      box-shadow: none;
      border: none;
      position: relative;
  }
  .uptime-badge {
      border: 1px solid var(--border-color);
      padding: 5px 12px;
      font-size: 0.9em;
      background: var(--bg-color);
      color: var(--text-primary);
      border-radius: 4px;
  }
  .indicator-row {
      display: flex;
      gap: 15px;
      margin-bottom: 25px;
      flex-wrap: wrap;
  }
  .indicator-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--border-color);
      padding: 6px 14px;
      font-size: 0.85em;
      font-family: monospace;
      background: transparent;
      border-radius: 4px;
  }
  .led-light {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #ccc;
      border: 1px solid var(--border-color);
      display: inline-block;
  }
  .led-light.active-green {
      background-color: #2ecc71;
      box-shadow: 0 0 8px #2ecc71;
  }
  .led-light.active-red {
      background-color: #e74c3c;
      box-shadow: 0 0 8px #e74c3c;
  }
  .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-bottom: 25px;
  }
  .metric-card {
      border: none;
      border-bottom: 1.5px solid var(--border-color);
      padding: 15px 0;
      background-color: transparent;
      position: relative;
  }
  .metric-card h3 {
      margin: 0 0 10px 0;
      font-size: 0.85em;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-secondary);
  }
  .metric-value {
      font-size: 1.8em;
      font-weight: bold;
  }
  .metric-subtext {
      font-size: 0.8em;
      margin-top: 5px;
      color: var(--text-secondary);
      font-family: monospace;
  }
  .main-panel-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 25px;
      margin-bottom: 25px;
  }
  @media (max-width: 900px) {
      .main-panel-grid {
          grid-template-columns: 1fr !important;
      }
      .page-tab-btn {
          max-width: 100% !important;
      }
  }
  .panel-box {
      border: none;
      border-bottom: 1.5px solid var(--border-color);
      padding: 20px 0;
      background-color: transparent;
  }
  .panel-title {
      font-size: 1.3em;
      margin-top: 0;
      margin-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 10px;
  }
  .en-sub {
      font-size: 0.85em;
      font-weight: normal;
      color: var(--text-secondary);
      font-style: italic;
      display: block;
      margin-top: 2px;
  }
  
  /* Page Tab Buttons Styling */
  .page-tab-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 10px 18px;
    font-family: inherit;
    font-size: 0.95em;
    font-weight: bold;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 6px;
    text-align: center;
    flex-grow: 1;
    max-width: 250px;
  }
  .page-tab-btn:hover {
    background: rgba(0, 0, 0, 0.03);
  }
  .page-tab-btn.active {
    background: var(--text-primary);
    color: var(--bg-color, #faf8f5);
    border-color: var(--text-primary);
  }

  /* Chart Range Toggle Button */
  .chart-toggle-btn {
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 6px 12px;
    font-family: inherit;
    font-size: 0.8em;
    font-weight: bold;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 4px;
  }
  .chart-toggle-btn:hover {
    background: rgba(0, 0, 0, 0.03);
  }
  .chart-toggle-btn.active {
    background: var(--text-primary);
    color: var(--bg-color, #faf8f5);
    border-color: var(--text-primary);
  }

  /* Scroller for full-width table tabs */
  .scroller {
    border: none;
  }
  .chart-container {
      position: relative;
      height: 250px;
      width: 100%;
  }
  table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      font-size: 0.9em;
  }
  th {
      background-color: var(--bg-color, #f3efe6);
      color: var(--text-primary);
      text-align: left;
      padding: 10px;
      border-bottom: 2px solid var(--border-color);
      font-weight: bold;
      position: sticky;
      top: 0;
      z-index: 10;
  }
  td {
      padding: 10px;
      border-bottom: 1px solid #e5dfd5;
      font-family: monospace;
  }
  .badge-win {
      color: var(--accent-green);
      font-weight: bold;
  }
  .badge-loss {
      color: var(--accent-red);
      font-weight: bold;
  }
  .btn {
      background-color: var(--card-bg);
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      padding: 8px 16px;
      font-family: 'Inter', sans-serif;
      font-size: 0.9em;
      cursor: pointer;
      transition: all 0.2s ease;
  }
  .btn:hover {
      background-color: #f3efe6;
  }
  .btn-danger {
      background-color: var(--accent-red);
      color: white;
      border-color: var(--accent-red);
  }
  .btn-danger:hover {
      background-color: #991b1b;
  }
  .log-console {
      background: #faf8f5;
      border: 1px solid var(--border-color);
      padding: 15px;
      font-family: monospace;
      white-space: pre-wrap;
      font-size: 0.85em;
      color: var(--text-primary);
      max-height: 250px;
      overflow-y: auto;
      margin-top: 25px;
  }
  .flashing {
      animation: flash-animation 0.5s alternate 2;
  }
  @keyframes flash-animation {
      from { background-color: transparent; }
      to { background-color: #fdf2f2; }
  }
</style>
