    function parseCorrectionReason(reason) {
        if (!reason) {
            return { symbol: '-', message: '-', context: '-' };
        }
        
        // Extract Symbol, e.g. [C98USDT]
        let symbol = '-';
        const symMatch = reason.match(/^\[(.*?)\]/);
        if (symMatch) {
            symbol = symMatch[1];
        }
        
        // Remove symbol prefix
        let workingText = reason.replace(/^\[.*?\]\s*/, '');
        
        // Extract Message & Context
        let message = workingText;
        let context = '-';
        
        if (workingText.includes(':')) {
            const parts = workingText.split(':');
            message = parts[0].trim();
            context = parts.slice(1).join(':').trim();
        } else if (workingText.includes('(')) {
            const idx = workingText.indexOf('(');
            message = workingText.substring(0, idx).trim();
            context = workingText.substring(idx).trim();
        }
        
        return { symbol, message, context };
    }

