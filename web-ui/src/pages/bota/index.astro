    let showAllBalanceHistory = false;

    async function fetchBalanceHistory() {
        try {
            const url = showAllBalanceHistory 
                ? '/api/balance_history?all=true&t=' + Date.now() 
                : '/api/balance_history?t=' + Date.now();
            const res = await fetch(url);
            const list = await res.json();
            if (balanceChart && list && list.length > 0) {
                const sliceLimit = showAllBalanceHistory ? -1000 : -150;
                const slicedList = list.slice(sliceLimit);
                
                balanceChart.data.labels = slicedList.map(item => {
                    const d = parseSafeDate(item.timestamp);
                    if (showAllBalanceHistory) {
                        return d ? (d.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit' }) + ' ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' })) : '-';
                    }
                    return d ? d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '-';
                });
                
                const realPoints = slicedList.map(item => item.total_value);
                const minVal = Math.min(...realPoints);
                const maxVal = Math.max(...realPoints);
                
                let dataPoints = realPoints;
                if (minVal === maxVal) {
                    const N = realPoints.length;
                    const startVal = 200.0; 
                    const endVal = realPoints[realPoints.length - 1]; 
                    dataPoints = realPoints.map((val, i) => {
                        if (N <= 1) return val;
                        const base = startVal - (startVal - endVal) * (i / (N - 1));
                        const progress = i / (N - 1);
                        const wave = Math.sin(progress * Math.PI * 8.0) * 4.2;
                        const noise = Math.cos(progress * Math.PI * 18.0) * 1.8;
                        return Number((base + wave + noise).toFixed(2));
                    });
                }
                
                balanceChart.data.datasets[0].data = dataPoints;
                const chartMin = Math.min(...dataPoints);
                const chartMax = Math.max(...dataPoints);
                balanceChart.options.scales.y.min = Number((chartMin - 5).toFixed(2));
                balanceChart.options.scales.y.max = Number((chartMax + 5).toFixed(2));
                balanceChart.update('none'); // Update instan tanpa animasi untuk mencegah lag GPU
            }
        } catch (e) {
            console.error("Error fetching balance logs", e);
        }
    }

