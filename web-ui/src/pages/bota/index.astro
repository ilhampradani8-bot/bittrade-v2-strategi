        if (secCalibration) secCalibration.style.display = 'none';
        if (secScanner) secScanner.style.display = 'none';

        if (tabName === 'overview') {
            btnOverview.classList.add('active');
            secOverview.style.display = 'block';
        } else if (tabName === 'history') {
            btnHistory.classList.add('active');
            secHistory.style.display = 'block';
        } else if (tabName === 'coins') {
            if (btnCoins) btnCoins.classList.add('active');
            if (secCoins) secCoins.style.display = 'block';
        } else if (tabName === 'conclude') {
            if (btnConclude) btnConclude.classList.add('active');
            if (secConclude) secConclude.style.display = 'block';
        } else if (tabName === 'corrections') {
            btnCorrections.classList.add('active');
            secCorrections.style.display = 'block';
        } else if (tabName === 'calibration') {
            if (btnCalibration) btnCalibration.classList.add('active');
            if (secCalibration) secCalibration.style.display = 'block';
            fetchCalibrationParams();
        } else if (tabName === 'scanner') {
            if (btnScanner) btnScanner.classList.add('active');
            if (secScanner) secScanner.style.display = 'block';
            renderScannerTable();
            fetchScannerLogs();
        }
    }
    window.switchPageTab = switchPageTab;

    function scrollTabs(amount) {
        const container = document.getElementById('tabs-scroll-container');
        if (container) {
            container.scrollLeft += amount;
        }
    }
    window.scrollTabs = scrollTabs;

    async function fetchCalibrationParams() {
        try {
            const res = await fetch('/api/parameters?t=' + Date.now());
            const data = await res.json();
            for (const item of data) {
                const cat = item.category.toLowerCase();
                const slEl = document.getElementById(`cell-${cat}-sl`);
                const tgEl = document.getElementById(`cell-${cat}-tg`);
                const pbEl = document.getElementById(`cell-${cat}-pb`);
                
                if (slEl) slEl.innerText = `${(Math.abs(item.stop_loss_limit) * 100.0).toFixed(1)}%`;
                if (tgEl) tgEl.innerText = `${(item.uptrend_tp_trail_trigger * 100.0).toFixed(1)}%`;
                if (pbEl) pbEl.innerText = `${(item.uptrend_tp_trail_pullback * 100.0).toFixed(1)}%`;
            }

            const logsRes = await fetch('/api/logs?t=' + Date.now());
            const logs = await logsRes.json();
            const filteredLogs = logs.filter(log => log.includes('[Sync]') || log.includes('[Admin]'));
            
            const logContainer = document.getElementById('calibration-log-list');
            const historyBody = document.getElementById('calibration-history-table-body');
            
            if (logContainer) {
                if (filteredLogs.length === 0) {
                    logContainer.innerHTML = '<div style="color: var(--text-secondary); opacity: 0.8;">No parameter sync events recorded yet.</div>';
                } else {
                    logContainer.innerHTML = filteredLogs.map(log => {
                        // Sederhanakan pesan log mentah di panel bawah agar lebih manusiawi
                        let cleanLog = log;
                        if (log.includes('Auto-Sync parameter strategi dari database bot_a_parameters berhasil')) {
                            cleanLog = log.replace(/\[Sync\].*$/, '🟢 [Auto-Sync] Parameter strategi disinkronkan otomatis dari database.');
                        } else if (log.includes('Sinkronisasi parameter strategi awal dari database')) {
                            cleanLog = log.replace(/\[Sync\].*$/, '🟢 [Startup-Sync] Parameter awal berhasil dimuat saat bot menyala.');
                        } else if (log.includes('Parameter strategi diperbarui secara manual oleh admin')) {
                            cleanLog = log.replace(/\[Admin\].*$/, '🔧 [Manual-Update] Parameter diperbarui secara manual oleh admin.');
                        }
                        
                        let color = 'var(--text-secondary)';
                        if (log.includes('[Sync]')) color = 'var(--accent-green)';
                        else if (log.includes('[Admin]')) color = 'var(--accent-blue)';
                        return `<div style="color: ${color}; border-bottom: 1px solid var(--border-color); padding: 4px 0;">${cleanLog}</div>`;
                    }).join('');
                }
            }

            // Tampilkan data ke tabel sejarah update
            if (historyBody) {
                if (filteredLogs.length === 0) {
                    historyBody.innerHTML = '<tr><td colspan="4" style="text-align: center; color: var(--text-secondary);">Belum ada riwayat update parameter...</td></tr>';
                } else {
                    let tableHtml = '';
                    filteredLogs.forEach(log => {
                        // Extract timestamp: format log biasanya "[YYYY-MM-DD HH:MM:SS] [Sync] ..."
                        let timeStr = '-';
                        const timeMatch = log.match(/^\[(.*?)\]/);
                        if (timeMatch) {
                            timeStr = timeMatch[1];
                        }

                        let actionType = 'Otomatis (System)';
                        let statusColor = 'var(--accent-green)';
                        let statusText = 'SUKSES';
                        let detailInfo = 'Sinkronisasi parameter memori';

                        if (log.includes('[Admin]')) {
                            actionType = 'Manual (Admin)';
                            statusColor = 'var(--accent-blue)';
                            detailInfo = 'Parameter diupdate secara manual oleh admin/user';
                        } else if (log.includes('Auto-Sync')) {
                            detailInfo = 'Auto-sync parameter trading 5-menitan dari database';
                        } else if (log.includes('awal dari database')) {
                            detailInfo = 'Sinkronisasi parameter awal saat bot baru menyala';
                        }

                        tableHtml += `
                            <tr>
                                <td style="font-family: monospace; font-weight: bold;">${timeStr}</td>
                                <td><span style="padding: 2px 6px; border-radius: 4px; font-size: 0.85em; font-weight: bold; background: rgba(0,0,0,0.05); color: ${statusColor};">${actionType}</span></td>
                                <td><span style="color: var(--accent-green); font-weight: bold;">● ${statusText}</span></td>
                                <td style="font-size: 0.9em; color: var(--text-secondary);">${detailInfo}</td>
                            </tr>
                        `;
                    });
                    historyBody.innerHTML = tableHtml;
                }
            }
        } catch (e) {
            console.error("Error fetching calibration parameters or logs", e);
        }
    }
    window.fetchCalibrationParams = fetchCalibrationParams;

    function renderScannerTable() {
        const body = document.getElementById('scanner-table-body');
        if (!body) return;
        
        if (!lastCoinStates || lastCoinStates.length === 0) {
            body.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-secondary);">Loading market scanner data...</td></tr>';
            return;
        }
        
        const sorted = [...lastCoinStates].filter(c => c.price > 0);
        sorted.sort((a, b) => (b.daily_volatility || 0) - (a.daily_volatility || 0));
        
        const top100 = sorted.slice(0, 100);
        
        if (top100.length === 0) {
            body.innerHTML = '<tr><td colspan="7" style="text-align: center; color: var(--text-secondary);">No active tickers found.</td></tr>';
            return;
        }
        
        function formatVol(val) {
            if (!val || val <= 0) return '-';
            if (val >= 1000000) return '$' + (val / 1000000).toFixed(2) + 'M';
            if (val >= 1000) return '$' + (val / 1000).toFixed(1) + 'K';
            return '$' + val.toFixed(0);
        }
        
        let html = '';
        top100.forEach((coin, idx) => {
            let direction = 'SAME';
            const oldData = window.previousPrices[coin.symbol];
            if (oldData) {
                if (coin.price > oldData.price) {
                    direction = 'UP';
                } else if (coin.price < oldData.price) {
                    direction = 'DOWN';
                } else {
                    direction = oldData.direction;
                }
            }
            window.previousPrices[coin.symbol] = { price: coin.price, direction: direction };
            
            let arrowHtml = '';
            let priceColorStyle = '';
            if (direction === 'UP') {
                arrowHtml = ' <span style="color: var(--accent-green); font-size: 0.85em; margin-left: 4px;">▲</span>';
                priceColorStyle = 'color: var(--accent-green);';
            } else if (direction === 'DOWN') {
                arrowHtml = ' <span style="color: var(--accent-red); font-size: 0.85em; margin-left: 4px;">▼</span>';
                priceColorStyle = 'color: var(--accent-red);';
            }
            
            const priceValStr = coin.price.toFixed(coin.price < 1.0 ? 5 : 2);
            const priceStr = `<span style="font-family: monospace; font-weight: bold; ${priceColorStyle}">${priceValStr}${arrowHtml}</span>`;
            
            const changeStr = coin.change_24h !== undefined ? (coin.change_24h >= 0 ? '+' : '') + coin.change_24h.toFixed(2) + '%' : '-';
            const changeClass = coin.change_24h >= 0 ? 'text-win' : 'text-loss';
            const volStr = formatVol(coin.quote_volume);
            const volRangeStr = coin.daily_volatility !== undefined ? coin.daily_volatility.toFixed(2) + '%' : '-';
            
            html += `
                <tr>
                    <td style="color: var(--text-secondary); font-family: monospace;">${idx + 1}</td>
                    <td><strong>${coin.symbol}</strong></td>
                    <td>${priceStr}</td>
                    <td class="${changeClass}" style="font-family: monospace; font-weight: bold;">${changeStr}</td>
                    <td style="font-family: monospace;">${volStr}</td>
                    <td style="font-family: monospace; font-weight: bold; color: var(--accent-blue);">${volRangeStr}</td>
                    <td><span class="category-tag category-${coin.volatility_category.toLowerCase()}">${coin.volatility_category}</span></td>
                </tr>
            `;
        });
        
        body.innerHTML = html;
    }
    window.renderScannerTable = renderScannerTable;

    async function fetchScannerLogs() {
        const container = document.getElementById('scanner-log-list');
        if (!container) return;
        try {
            const res = await fetch('/api/logs?t=' + Date.now());
            const logs = await res.json();
            if (logs.length === 0) {
                container.innerHTML = '<div style="color: var(--text-secondary);">No logs recorded.</div>';
            } else {
                // Batasi hanya merender 100 baris log terbaru agar browser tidak lag
                const recentLogs = logs.slice(-100);
                container.innerHTML = recentLogs.map(log => {
                    let color = 'var(--text-primary)';
                    if (log.includes('ERR') || log.includes('🚨') || log.includes('Gagal')) color = 'var(--accent-red)';
                    else if (log.includes('BUY') || log.includes('SUCCESS') || log.includes('Profit')) color = 'var(--accent-green)';
                    else if (log.includes('SELL')) color = 'var(--accent-orange)';
                    else if (log.includes('Sync')) color = 'var(--accent-blue)';
                    return `<div style="color: ${color}; margin-bottom: 4px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 2px;">${log}</div>`;
                }).join('');
                container.scrollTop = container.scrollHeight;
            }
        } catch (e) {
            console.error("Error fetching scanner logs", e);
            container.innerHTML = '<div style="color: var(--accent-red);">Failed to connect to log stream.</div>';
        }
    }
    window.fetchScannerLogs = fetchScannerLogs;

    // Loop data retrieval
    // fetchStatus now uses self-scheduling setTimeout (with backoff), not setInterval
    fetchStatus();
    fetchHistory();
    fetchCorrections();
    fetchBalanceHistory();
    
    // Inisialisasi awal log jika langsung di tab scanner
    if (window.activePageTab === 'scanner') {
        fetchScannerLogs();
    }
    
    // Polling log scanner terpisah (5 detik sekali) untuk meringankan load CPU
    setInterval(() => {
        if (window.activePageTab === 'scanner') {
            fetchScannerLogs();
        }
    }, 5000);

    setInterval(updateUptime, 1000);
    setInterval(fetchHistory, 10000);
    setInterval(fetchCorrections, 30000);
    setInterval(fetchBalanceHistory, 30000);
  </script>
</Layout>

