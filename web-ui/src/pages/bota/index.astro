---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Bot A Dashboard: Multi-Coin Scalper Engine | BitTrade Q-Lab"
  description="Real-time monitoring dashboard for Bot A (Trend Following & Scalper Engine) trading volatile spot pairs."
  botStatus="BOT A ONLINE"
>
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Michroma&family=Orbitron:wght@400;700&display=swap" rel="stylesheet" />
  <!-- API Offline Banner -->
  <div id="api-offline-banner" style="display:none; position: sticky; top: 0; z-index: 9999; background: #b71c1c; color: #fff; font-family: monospace; font-size: 0.92em; font-weight: bold; padding: 10px 20px; text-align: center; letter-spacing: 0.5px; border-bottom: 2px solid #ff1744; box-shadow: 0 2px 8px rgba(183,28,28,0.4);">
    ⚠️ API BOT A OFFLINE — Mencoba Reconnect... &nbsp;|&nbsp; <span id="retry-countdown">Mencoba ulang dalam 5 detik...</span>
  </div>

  <div class="dashboard-container">
    <!-- Top Header & Global Status -->
    <div class="header-container">
      <h1 class="main-title">Multi-Coin Scalper Live Dashboard (Bot A)</h1>
      <div class="top-stats-row">
        <div class="uptime-badge">Bot Uptime: <span id="uptime-counter">00:00:00</span></div>
        <div class="uptime-badge winrate-badge">Winrate: <span id="winrate-counter">0.0%</span> <span id="win-loss-count" style="font-size: 0.85em; opacity: 0.9; margin-left: 5px;">(0W / 0L)</span></div>
      </div>
    </div>

    <!-- Classic, Responsive Navigation Tabs -->
    <div style="display: flex; align-items: center; gap: 8px; width: 100%; margin-bottom: 25px; border-bottom: 2px solid var(--border-color); padding-bottom: 12px; position: relative;">
      <button id="btn-scroll-left" class="scroll-btn" onclick="scrollTabs(-120)">&lt;</button>
      <div id="tabs-scroll-container" class="tabs-nav-bar" style="display: flex; gap: 8px; flex-wrap: nowrap; overflow-x: auto; scroll-behavior: smooth; border: none; padding-bottom: 0; margin-bottom: 0; flex-grow: 1; -webkit-overflow-scrolling: touch;">
        <button id="btn-page-overview" class="page-tab-btn active" onclick="switchPageTab('overview')">
          Overview Summary
        </button>
        <button id="btn-page-history" class="page-tab-btn" onclick="switchPageTab('history')">
          Execution History
        </button>
        <button id="btn-page-coins" class="page-tab-btn" onclick="switchPageTab('coins')">
          Monitored Coins
        </button>
        <button id="btn-page-conclude" class="page-tab-btn" onclick="switchPageTab('conclude')">
          Conclude Day
        </button>
        <button id="btn-page-corrections" class="page-tab-btn" onclick="switchPageTab('corrections')">
          System Corrections
        </button>
        <button id="btn-page-calibration" class="page-tab-btn" onclick="switchPageTab('calibration')">
          Rule Calibration
        </button>
        <button id="btn-page-scanner" class="page-tab-btn" onclick="switchPageTab('scanner')">
          Market Scanner
        </button>
      </div>
      <button id="btn-scroll-right" class="scroll-btn" onclick="scrollTabs(120)">&gt;</button>
    </div>

    <!-- Tab 1: Overview Section -->
    <div id="section-overview" class="page-section">
      <!-- Info Cards Row -->
      <div class="grid-2" style="margin-bottom: 20px;">
        <!-- Card 1: Active Session Duration -->
        <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px; margin: 0;">
          <h2 style="margin: 0 0 12px 0; font-size: 1.2em; font-weight: bold; border: none; padding-bottom: 0;">Active Session Duration</h2>
          <div style="font-size: 0.95em; line-height: 1.6; font-family: monospace;">
            <div><strong>Start Time:</strong> <span id="session-start-time">-</span></div>
            <div><strong>Current Time:</strong> <span id="session-current-time">-</span></div>
            <div><strong>Running Duration:</strong> <span id="session-uptime">-</span></div>
          </div>
        </div>

        <!-- Card 2: Account Balances -->
        <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px; margin: 0;">
          <h2 style="margin: 0 0 15px 0; font-size: 1.25em; font-weight: bold; border: none; padding-bottom: 0;">Account Balances</h2>
          <div style="font-size: 1.05em; line-height: 1.6; font-family: monospace;">
            <div class="stat-row">
              <span class="label">Starting Capital</span>
              <span class="value">$200.00</span>
            </div>
            <div class="stat-row">
              <span class="label">Remaining Cash (USDT)</span>
              <span class="value" id="usdt-balance">$200.00</span>
            </div>
            <div class="stat-row">
              <span class="label">Invested in Coins</span>
              <span class="value" id="invested-balance">$0.00</span>
            </div>
            <div class="stat-row" style="border-top: 1.5px solid var(--border-color); padding-top: 8px; margin-top: 8px;">
              <span class="label" style="font-weight: bold; color: var(--text-primary);">Total Account Equity</span>
              <span class="value" id="total-equity-val" style="font-weight: bold; font-size: 1.1em;">$200.00</span>
            </div>
            <div class="stat-row">
              <span class="label" style="font-weight: bold; color: var(--text-primary);">Overall Net P&amp;L</span>
              <span class="value" id="pnl-value" style="font-weight: bold; font-size: 1.1em;">$0.00 (0.00%)</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Asset Equity Development Chart Box (Full Width) -->
      <div class="card" style="margin-bottom: 20px; padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
          <h2 style="margin: 0; font-size: 1.25em; font-weight: bold; border: none; padding-bottom: 0;">Asset Equity Development</h2>
          <button id="btn-chart-all" class="chart-toggle-btn" onclick="toggleBalanceHistoryRange()">
            Show All Data
          </button>
        </div>
        <div style="height: 320px; position: relative;"><canvas id="balanceChart"></canvas></div>
      </div>
    </div>

    <!-- Tab 2: Execution History Section -->
    <div id="section-history" class="page-section" style="display: none;">
      <div class="section-title-container">
        <h2>Execution Log History</h2>
      </div>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Symbol</th>
              <th>Action</th>
              <th>Price (USD)</th>
              <th>Amount</th>
              <th>Total USD</th>
              <th>Strategy</th>
              <th>Execution Reason</th>
              <th>Admin Fee</th>
              <th>Net P&amp;L</th>
            </tr>
          </thead>
          <tbody id="history-body">
            <tr><td colspan="10" style="text-align: center; color: var(--text-secondary);">Loading transaction history...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab 3: Conclude Day Section -->
    <div id="section-conclude" class="page-section" style="display: none;">
      <div class="section-title-container">
        <h2>Conclude Day Statistics</h2>
      </div>
      <div id="conclude-daily-body">
        <div style="text-align: center; color: var(--text-secondary); padding: 25px;">Loading statistics...</div>
      </div>
    </div>

    <!-- Tab 4: Monitored Coins Section -->
    <div id="section-coins" class="page-section" style="display: none;">
      <!-- Active Positions (Held Coins) Info List -->
      <div class="card" style="margin-bottom: 25px; padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px;">
        <h2 style="margin: 0 0 12px 0; border: none; padding-bottom: 0; font-size: 1.25em; font-weight: bold;">Active Trade Positions (Currently Held Coins)</h2>
        <div id="held-coins-list">
          <div style="text-align: center; color: var(--text-secondary); padding: 15px;">Checking held coin positions...</div>
        </div>
      </div>

      <!-- Monitored Coins Real-time Table Grid -->
      <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px;">
        <h2 style="margin: 0 0 12px 0; border: none; padding-bottom: 0; font-size: 1.25em; font-weight: bold;">Dynamic Volatility Tiers Monitor</h2>
        <p style="font-size: 0.9em; margin-bottom: 15px; color: var(--text-secondary);">
          Bot monitors 40 volatile Binance coins simultaneously. Select a volatility class below to inspect real-time prices, trends, and active position statuses.
        </p>

        <!-- Category Sub-tabs Selection -->
        <div style="display: flex; gap: 8px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin-bottom: 15px; flex-wrap: wrap;">
          <button id="btn-subtab-extreme" class="sub-tab-btn active" onclick="switchCategorySubtab('EXTREME')" style="padding: 6px 14px; border: 1.5px solid var(--border-color); border-radius: 4px; font-weight: bold; background: none; color: var(--text-primary); cursor: pointer;">
            EXTREME <span style="font-size: 0.8em; font-weight: normal; color: var(--accent-red);">(>= 3.0%)</span>
          </button>
          <button id="btn-subtab-hyper" class="sub-tab-btn" onclick="switchCategorySubtab('HYPER')" style="padding: 6px 14px; border: 1.5px solid var(--border-color); border-radius: 4px; font-weight: bold; background: none; color: var(--text-primary); cursor: pointer;">
            HYPER <span style="font-size: 0.8em; font-weight: normal; color: #d84315;">(1.5% - 3.0%)</span>
          </button>
          <button id="btn-subtab-high" class="sub-tab-btn" onclick="switchCategorySubtab('HIGH')" style="padding: 6px 14px; border: 1.5px solid var(--border-color); border-radius: 4px; font-weight: bold; background: none; color: var(--text-primary); cursor: pointer;">
            HIGH <span style="font-size: 0.8em; font-weight: normal; color: var(--accent-yellow);">(0.5% - 1.5%)</span>
          </button>
          <button id="btn-subtab-low" class="sub-tab-btn" onclick="switchCategorySubtab('LOW')" style="padding: 6px 14px; border: 1.5px solid var(--border-color); border-radius: 4px; font-weight: bold; background: none; color: var(--text-primary); cursor: pointer;">
            LOW / MEDIUM <span style="font-size: 0.8em; font-weight: normal; color: var(--accent-blue);">(< 0.5%)</span>
          </button>
        </div>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th style="width: 50px;">No</th>
                <th>Coin Symbol</th>
                <th>Volatility Class</th>
                <th>Current Price</th>
                <th>24h Change</th>
                <th>24h Volume (USDT)</th>
                <th>Trend Direction</th>
                <th>Bot Active Position Status</th>
              </tr>
            </thead>
            <tbody id="monitored-coins-table-body">
              <tr>
                <td colspan="8" style="text-align: center; color: var(--text-secondary);">Loading monitored coins data...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Tab 5: System Corrections Section -->
    <div id="section-corrections" class="page-section" style="display: none;">
      <div class="section-title-container">
        <h2>System Failures &amp; Corrections Log</h2>
      </div>
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Symbol</th>
              <th>Error Type</th>
              <th>Message</th>
              <th>Context Detail</th>
            </tr>
          </thead>
          <tbody id="corrections-body">
            <tr><td colspan="5" style="text-align: center; color: var(--text-secondary);">No system corrections recorded...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab 6: Rule Calibration Section -->
    <div id="section-calibration" class="page-section" style="display: none;">
      <div class="section-title-container">
        <h2>Trading Parameter &amp; Rule Calibration</h2>
      </div>

      <!-- Active Volatility Rules Configuration (Read-only) -->
      <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px; margin-bottom: 25px;">
        <h3 style="margin: 0 0 12px 0; font-size: 1.15em; font-weight: bold;">Active Parameter Configuration Tiers</h3>
        <p style="font-size: 0.9em; color: var(--text-secondary); margin-bottom: 18px;">
          Active trading parameters for each coin volatility class stored in the database.
        </p>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Volatility Tier</th>
                <th>Stop Loss Limit (%)</th>
                <th>Trailing TP Trigger (%)</th>
                <th>Trailing TP Pullback (%)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>EXTREME</strong></td>
                <td id="cell-extreme-sl" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-extreme-tg" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-extreme-pb" style="font-family: monospace; font-weight: bold;">-</td>
              </tr>
              <tr>
                <td><strong>HYPER</strong></td>
                <td id="cell-hyper-sl" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-hyper-tg" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-hyper-pb" style="font-family: monospace; font-weight: bold;">-</td>
              </tr>
              <tr>
                <td><strong>HIGH</strong></td>
                <td id="cell-high-sl" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-high-tg" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-high-pb" style="font-family: monospace; font-weight: bold;">-</td>
              </tr>
              <tr>
                <td><strong>LOW</strong></td>
                <td id="cell-low-sl" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-low-tg" style="font-family: monospace; font-weight: bold;">-</td>
                <td id="cell-low-pb" style="font-family: monospace; font-weight: bold;">-</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Parameter Update History Table -->
      <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px; margin-bottom: 25px;">
        <h3 style="margin: 0 0 12px 0; font-size: 1.15em; font-weight: bold;">Parameter Update History</h3>
        <p style="font-size: 0.9em; color: var(--text-secondary); margin-bottom: 15px;">
          Tabel riwayat perubahan parameter kalibrasi yang berhasil disinkronkan ke dalam sistem trading.
        </p>
        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Waktu Update</th>
                <th>Jenis Aksi</th>
                <th>Status Kinerja</th>
                <th>Detail Informasi</th>
              </tr>
            </thead>
            <tbody id="calibration-history-table-body">
              <tr>
                <td colspan="4" style="text-align: center; color: var(--text-secondary);">Belum ada riwayat update parameter...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Parameter Sync Log Panel -->
      <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px;">
        <h3 style="margin: 0 0 12px 0; font-size: 1.15em; font-weight: bold;">System Parameter Update Log</h3>
        <p style="font-size: 0.9em; color: var(--text-secondary); margin-bottom: 15px;">
          Log mentah aktivitas sinkronisasi database parameters dan kalibrasi bot.
        </p>
        <div id="calibration-log-list" style="font-family: monospace; font-size: 0.9em; background: rgba(0,0,0,0.02); padding: 12px; border-radius: 4px; max-height: 250px; overflow-y: auto; line-height: 1.6;">
          <div style="color: var(--text-secondary);">Loading calibration log history...</div>
        </div>
      </div>
    </div>

    <!-- Tab 7: All Market Scanner Section -->
    <div id="section-scanner" class="page-section" style="display: none;">
      <div class="section-title-container">
        <h2>All Market Scanner (400+ Coins)</h2>
      </div>

      <div class="grid-2" style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; align-items: start;">
        <!-- Left: Ticker list -->
        <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px;">
          <h3 style="margin: 0 0 12px 0; font-size: 1.15em; font-weight: bold;">Potential Scalping Ticker Scan</h3>
          <p style="font-size: 0.9em; color: var(--text-secondary); margin-bottom: 18px;">
            Real-time feed of all available USDT pairs sorted by **Potential (Daily Volatility Range)**.
          </p>
          <div class="table-responsive" style="max-height: 700px; overflow-y: auto;">
            <table>
              <thead>
                <tr>
                  <th style="width: 50px;">No</th>
                  <th>Symbol</th>
                  <th>Price</th>
                  <th>24h Change</th>
                  <th>24h Volume (USDT)</th>
                  <th>Volatility Range</th>
                  <th>Volatility Tier</th>
                </tr>
              </thead>
              <tbody id="scanner-table-body">
                <tr>
                  <td colspan="7" style="text-align: center; color: var(--text-secondary);">Loading market scanner data...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right: Bot Log Stream -->
        <div class="card" style="padding: 18px; border: 1.5px solid var(--border-color); border-radius: 6px;">
          <h3 style="margin: 0 0 12px 0; font-size: 1.15em; font-weight: bold;">Live Bot Activity Log</h3>
          <p style="font-size: 0.9em; color: var(--text-secondary); margin-bottom: 18px;">
            Real-time stdout log stream directly from the running Rust bot instance.
          </p>
          <div id="scanner-log-list" style="font-family: monospace; font-size: 0.85em; background: rgba(0,0,0,0.03); padding: 12px; border-radius: 4px; height: 630px; overflow-y: auto; line-height: 1.6; white-space: pre-wrap; word-break: break-all;">
            <div style="color: var(--text-secondary);">Connecting to bot log stream...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script is:inline>
    let lastPrice = 0;
    let botStartTime = null;
    let currentCategorySubtab = "EXTREME";
    let lastCoinStates = [];
    window.previousPrices = {};
    window.activePageTab = "overview";

    // Chart Price disabled as requested in Overview
    const priceChart = null;

    // Balance/Equity Chart
    const ctxBalance = document.getElementById('balanceChart').getContext('2d');
    const balanceChart = new Chart(ctxBalance, {
        type: 'line',
        data: {
            labels: [],
            datasets: [{
                borderColor: '#2e7d32',
                borderWidth: 2,
                data: [],
                fill: false,
                tension: 0.15,
                pointRadius: 0
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { ticks: { color: '#555555' }, grid: { color: '#e5dfd5' } },
                y: { ticks: { color: '#555555' }, grid: { color: '#e5dfd5' } }
            }
        }
    });

    const fmtUSD = (val) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(val);

    function parseSafeDate(dateStr) {
        if (!dateStr) return null;
        let cleanStr = dateStr;
        if (dateStr.includes('.')) {
            const parts = dateStr.split('.');
            const timePart = parts[0];
            let subPart = parts[1] || "";
            const zIndex = subPart.indexOf('Z');
            if (zIndex !== -1) {
                subPart = subPart.substring(0, Math.min(3, zIndex)) + 'Z';
            } else {
                const plusIndex = subPart.indexOf('+');
                const minusIndex = subPart.indexOf('-');
                const offsetIndex = plusIndex !== -1 ? plusIndex : minusIndex;
                if (offsetIndex !== -1) {
                    const offset = subPart.substring(offsetIndex);
                    subPart = subPart.substring(0, Math.min(3, offsetIndex)) + offset;
                } else {
                    subPart = subPart.substring(0, 3);
                }
            }
            cleanStr = timePart + '.' + subPart;
        }
        const d = new Date(cleanStr);
        return isNaN(d.getTime()) ? null : d;
    }

    function updateUptime() {
        if (!botStartTime) return;
        const diffMs = new Date() - botStartTime;
        const diffSecs = Math.floor(diffMs / 1000);
        const hrs = String(Math.floor(diffSecs / 3600)).padStart(2, '0');
        const mins = String(Math.floor((diffSecs % 3600) / 60)).padStart(2, '0');
        const secs = String(diffSecs % 60).padStart(2, '0');
        
        const uptimeStr = `${hrs}:${mins}:${secs}`;
        const el = document.getElementById('uptime-counter');
        if (el) el.innerText = uptimeStr;
        
        const elSessionUptime = document.getElementById('session-uptime');
        if (elSessionUptime) elSessionUptime.innerText = uptimeStr;
    }

    function formatDate(dateObj) {
        if (!dateObj) return '-';
        return dateObj.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' }) + ' ' + dateObj.toLocaleTimeString('en-US');
    }

    // --- API Connection Health State ---
    let apiOffline = false;
    let statusPollDelay = 1000;       // start at 1s, back off to max 30s when offline
    let statusPollTimer = null;
    const STATUS_POLL_MIN = 1000;
    const STATUS_POLL_MAX = 30000;

    function showOfflineBanner(nextRetrySec) {
        const banner = document.getElementById('api-offline-banner');
        const cd = document.getElementById('retry-countdown');
        if (banner) banner.style.display = 'block';
        if (cd) cd.innerText = `Mencoba ulang dalam ${nextRetrySec} detik...`;
    }
    function hideOfflineBanner() {
        const banner = document.getElementById('api-offline-banner');
        if (banner) banner.style.display = 'none';
    }

    function scheduleNextStatusPoll() {
        if (statusPollTimer) clearTimeout(statusPollTimer);
        statusPollTimer = setTimeout(fetchStatus, statusPollDelay);
    }

    async function fetchStatus() {
        try {
            const res = await fetch('/api/status?t=' + Date.now());
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();

            // API is back online — reset backoff
            if (apiOffline) {
                apiOffline = false;
                statusPollDelay = STATUS_POLL_MIN;
                hideOfflineBanner();
            }

            // Set session start time
            if (!botStartTime && data.start_time) {
                botStartTime = parseSafeDate(data.start_time);
                const elSessionStart = document.getElementById('session-start-time');
                if (elSessionStart) elSessionStart.innerText = formatDate(botStartTime);
            }

            // Update current time label
            const elSessionCurrent = document.getElementById('session-current-time');
            if (elSessionCurrent) elSessionCurrent.innerText = formatDate(new Date());

            // Update global winrate
            const elWinrate = document.getElementById('winrate-counter');
            const elWinLoss = document.getElementById('win-loss-count');
            if (elWinrate) elWinrate.innerText = data.winrate.toFixed(1) + '%';
            const totalWins = data.win_sells || 0;
            const totalLosses = (data.total_sells || 0) - totalWins;
            if (elWinLoss) elWinLoss.innerText = `(${totalWins}W / ${totalLosses}L)`;

            // Update coin state structures
            lastCoinStates = data.coin_states || [];
            renderMonitoredCoinsTable();
            renderHeldCoinsList();
            
            if (window.activePageTab === 'scanner') {
                renderScannerTable();
            }

            // Update account balance details dynamically
            const usdt = data.simulated_balance || 0;
            let invested = 0;
            let unrealizedPnl = 0;

            if (data.coin_states) {
                for (const coin of data.coin_states) {
                    if (coin.position) {
                        const cost = coin.position.buy_price * coin.position.amount;
                        invested += cost;
                        unrealizedPnl += (coin.price - coin.position.buy_price) * coin.position.amount;
                    }
                }
            }

            const totalEquity = usdt + invested;
            const pnlAbsolute = totalEquity - 200.0;
            const pnlPercentage = (pnlAbsolute / 200.0) * 100.0;

            const elUsdt = document.getElementById('usdt-balance');
            const elInvested = document.getElementById('invested-balance');
            const elTotal = document.getElementById('total-equity-val');
            const elPnl = document.getElementById('pnl-value');

            if (elUsdt) elUsdt.innerText = fmtUSD(usdt);
            if (elInvested) elInvested.innerText = fmtUSD(invested);
            if (elTotal) elTotal.innerText = fmtUSD(totalEquity);
            if (elPnl) {
                const prefix = pnlAbsolute >= 0 ? '+' : '';
                elPnl.innerText = `${prefix}${fmtUSD(pnlAbsolute)} (${prefix}${pnlPercentage.toFixed(2)}%)`;
                elPnl.style.color = pnlAbsolute >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';
            }
        } catch (e) {
            // API is offline — apply exponential backoff
            apiOffline = true;
            statusPollDelay = Math.min(statusPollDelay * 2, STATUS_POLL_MAX);
            const nextRetrySec = Math.round(statusPollDelay / 1000);
            console.warn(`[Bot A] API offline. Retry in ${nextRetrySec}s`, e.message);
            showOfflineBanner(nextRetrySec);
        } finally {
            scheduleNextStatusPoll();
        }
    }

    function parseExecutionNotes(notes) {
        if (!notes) {
            return { strategy: '-', reason: '-', fee: '-', pnl: '-' };
        }
        
        // Extract Strategy, e.g. [Trending]
        let strategy = '-';
        const stratMatch = notes.match(/^\[(.*?)\]/);
        if (stratMatch) {
            strategy = stratMatch[1];
        }
        
        // Remove strategy prefix
        let workingText = notes.replace(/^\[.*?\]\s*/, '');
        
        // Extract P&L
        let pnl = '-';
        const pnlMatch = notes.match(/P&L:\s*[\$\+\-]*([0-9.]+)/);
        if (pnlMatch) {
            const isNegative = notes.includes('P&L: $-') || notes.includes('P&L: -');
            const prefix = isNegative ? '-' : '+';
            pnl = `${prefix}$${parseFloat(pnlMatch[1]).toFixed(2)}`;
        }
        
        // Extract Fee
        let fee = '-';
        const feeMatch = notes.match(/Biaya admin 0.1%:\s*\$?([0-9.]+)/);
        if (feeMatch) {
            fee = `$${parseFloat(feeMatch[1]).toFixed(4)}`;
        }
        
        // Extract Reason
        let reason = workingText.split('|')[0].trim();
        
        return { strategy, reason, fee, pnl };
    }

