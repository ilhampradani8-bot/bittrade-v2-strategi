                        </div>
                        <div style="font-size: 0.85em; opacity: 0.8; margin-top: 5px;">Executions: ${dailyTrades} trades</div>
                    </div>
                    <div class="stat-card" style="padding: 15px; border: 1.5px solid var(--border-color); border-radius: 6px; background: rgba(0,0,0,0.01);">
