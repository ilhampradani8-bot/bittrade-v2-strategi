    function renderMonitoredCoinsTable() {
        const body = document.getElementById('monitored-coins-table-body');
        if (!body) return;
        
        if (!lastCoinStates || lastCoinStates.length === 0) {
            body.innerHTML = '<tr><td colspan="6" style="text-align: center; color: var(--text-secondary);">Loading coin data...</td></tr>';
            return;
        }
        
        const filtered = lastCoinStates.filter(c => c.volatility_category === currentCategorySubtab);
        filtered.sort((a, b) => a.symbol.localeCompare(b.symbol));
        
        if (filtered.length === 0) {
            body.innerHTML = '<tr><td colspan="8" style="text-align: center; color: var(--text-secondary);">No coins in this category.</td></tr>';
            return;
        }

        function formatVolume(val) {
            if (!val || val <= 0) return '-';
            if (val >= 1000000) return '$' + (val / 1000000).toFixed(2) + 'M';
            if (val >= 1000) return '$' + (val / 1000).toFixed(1) + 'K';
            return '$' + val.toFixed(0);
        }
        
        let html = '';
        filtered.forEach((coin, idx) => {
            let direction = 'SAME';
            const oldData = window.previousPrices[coin.symbol];
            if (oldData) {
                if (coin.price > oldData.price) {
                    direction = 'UP';
                } else if (coin.price < oldData.price) {
                    direction = 'DOWN';
                } else {
                    direction = oldData.direction;
                }
            }
            window.previousPrices[coin.symbol] = { price: coin.price, direction: direction };

            let arrowHtml = '';
            let priceColorStyle = '';
            if (direction === 'UP') {
                arrowHtml = ' <span style="color: var(--accent-green); font-size: 0.85em; margin-left: 4px;">▲</span>';
                priceColorStyle = 'color: var(--accent-green);';
            } else if (direction === 'DOWN') {
                arrowHtml = ' <span style="color: var(--accent-red); font-size: 0.85em; margin-left: 4px;">▼</span>';
                priceColorStyle = 'color: var(--accent-red);';
            }

            const priceValStr = coin.price > 0 ? coin.price.toFixed(coin.price < 1.0 ? 5 : 2) : '-';
            const priceStr = coin.price > 0 ? `<span style="font-family: monospace; font-weight: bold; ${priceColorStyle}">${priceValStr}${arrowHtml}</span>` : '-';
            
            const changeStr = coin.change_24h !== undefined ? (coin.change_24h >= 0 ? '+' : '') + coin.change_24h.toFixed(2) + '%' : '-';
            const changeClass = coin.change_24h >= 0 ? 'text-win' : 'text-loss';
            const volStr = formatVolume(coin.quote_volume);
            
            let trendClass = 'badge-sideways';
            let trendLabel = 'SIDEWAYS';
            if (coin.trend_status === 'BULLISH' || coin.market_regime === 'BULLISH') {
                trendClass = 'badge-bullish';
                trendLabel = 'UP (Bullish)';
            } else if (coin.trend_status === 'BEARISH' || coin.market_regime === 'BEARISH') {
                trendClass = 'badge-bearish';
                trendLabel = 'DOWN (Bearish)';
            }
            
            let posHtml = '<span style="color: var(--text-secondary); opacity: 0.8;">Standby / No Position</span>';
            if (coin.position) {
                const pos = coin.position;
                const unrealizedPnl = ((coin.price - pos.buy_price) / pos.buy_price) * 100.0;
                const pnlClass = unrealizedPnl >= 0 ? 'color: var(--accent-green);' : 'color: var(--accent-red);';
                posHtml = `
                    <div style="font-size: 0.85em; border-left: 3px solid var(--accent-green); padding-left: 8px;">
                        <span style="font-weight: bold; color: var(--accent-green);">HOLDING</span><br/>
                        <span>Entry: $${pos.buy_price.toFixed(pos.buy_price < 1.0 ? 4 : 2)} | Qty: ${pos.amount.toFixed(4)}</span><br/>
                        <span style="font-weight: bold; ${pnlClass}">P&L: ${unrealizedPnl >= 0 ? '+' : ''}${unrealizedPnl.toFixed(2)}%</span>
                    </div>
                `;
            }
            
            html += `
                <tr>
                    <td style="color: var(--text-secondary); font-family: monospace;">${idx + 1}</td>
                    <td><strong>${coin.symbol}</strong></td>
                    <td><span class="category-tag category-${coin.volatility_category.toLowerCase()}">${coin.volatility_category}</span></td>
                    <td>${priceStr}</td>
                    <td class="${changeClass}" style="font-family: monospace; font-weight: bold;">${changeStr}</td>
                    <td style="font-family: monospace;">${volStr}</td>
                    <td><span class="trend-badge ${trendClass}">${trendLabel}</span></td>
                    <td>${posHtml}</td>
                </tr>
            `;
        });
        
        body.innerHTML = html;
    }

