    function extractPnlValue(notes) {
        if (!notes) return 0;
        // Match numbers like P&L: $+5.23 or P&L: +$1.20 or P&L: -0.45
        const match = notes.match(/P&L:\s*[\$\+\-]*([0-9.]+)/);
        if (match) {
            const isNegative = notes.includes('P&L: $-') || notes.includes('P&L: -');
            const val = parseFloat(match[1]);
            return isNegative ? -val : val;
        }
        return 0;
    }

    function updateConcludeDay(historyList) {
        const container = document.getElementById('conclude-daily-body');
        if (!container) return;
        
        let dailyProfit = 0;
        let monthlyProfit = 0;
        let dailyTrades = 0;
        let monthlyTrades = 0;
        
        const now = new Date();
        const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
        
        for (const item of historyList) {
            if (item.action === 'SELL' && item.status === 'SUCCESS') {
                const tradeTime = parseSafeDate(item.timestamp);
                if (!tradeTime) continue;
                const pnl = extractPnlValue(item.notes);
                
                if (tradeTime >= startOfToday) {
                    dailyProfit += pnl;
                    dailyTrades += 1;
                }
                if (tradeTime >= startOfMonth) {
                    monthlyProfit += pnl;
                    monthlyTrades += 1;
                }
            }
        }
        
        const targetDaily = 10.0; // 5% of $200 starting capital
        const targetMonthly = 300.0;
        
        const dailyPct = (dailyProfit / 200.0) * 100.0;
        const monthlyPct = (monthlyProfit / 200.0) * 100.0;
        
        const dailyStatus = dailyProfit >= targetDaily ? 'PASSED ✅' : 'RUNNING ⏳';
        const monthlyStatus = monthlyProfit >= targetMonthly ? 'PASSED ✅' : 'RUNNING ⏳';
        
        container.innerHTML = `
